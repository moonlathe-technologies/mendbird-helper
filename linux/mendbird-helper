#!/bin/sh
# Mendbird helper for Linux servers. Version 1.3.0.
#
# Lists the software this server runs: the operating system and its installed packages, the web server, PHP, Node.js
# and the database, with their exact versions. Once a day it sends that list to Mendbird, which checks every version
# against the lists of known security flaws, including the fixes your system has made to its own packages.
#
# How it works, in full, because you should be able to check:
#
# 1. It reads package names and versions with the system's own tools (dpkg-query, rpm or apk), and asks the web
#    server, PHP, Node.js and the database for their version numbers. If you list your apps below, it also reads the
#    names and versions of the packages each one is built from, including any second set a bundled tool carries in a
#    folder of its own, and the opening comment of script files copied in by hand (such as a copy of jQuery). Nothing
#    else is read, and nothing in your apps is run.
# 2. It signs the list with the secret key below and posts it to https://mendbird.com/api/helper. Mendbird refuses
#    anything unsigned, older than five minutes, or sent twice.
# 3. It opens no port, takes no instructions, and needs no root: any user can run it.
#
# To see exactly what it sends, without sending anything:
#
#     mendbird-helper --show
#
# It holds your key, so keep it where only the user who runs it can read it. As that user:
#
#     install -m 700 mendbird-helper "$HOME/mendbird-helper"
#
# then add one line to that user's crontab to run it daily:
#
#     17 4 * * * $HOME/mendbird-helper
#
# Delete it and remove that line, and it stops. Licence: MIT.
# The code is public at https://github.com/moonlathe-technologies/mendbird-helper

set -eu
umask 077

# Written in by Mendbird when you downloaded this copy. "Make a new key" in your Mendbird account retires it.
KEY='__MENDBIRD_KEY__'
SITE='__MENDBIRD_SITE__'
VERSION='1.3.0'

# Your own apps, if this server runs any: Python, Node.js, PHP, Ruby, Rust or Go. Put each app's folder here, separated
# by spaces, or the path of a Go program. For example: APPS='/srv/shop /srv/api/bin/server'
# Setting MENDBIRD_APPS on the crontab line does the same.
APPS=''
APPS="${MENDBIRD_APPS:-$APPS}"
URL="${MENDBIRD_URL:-https://mendbird.com}/api/helper"

# Only plain package characters ever go into the list, so nothing can break out of the JSON.
clean() { tr -cd 'A-Za-z0-9.+:~_@/ -'; }
clean_lines() { tr -cd 'A-Za-z0-9.+:~_@/ \n-'; }

# One JSON entry per line of "name version" read from standard input. A second argument is the folder a second set of
# packages was found in, inside an app.
entries() {
	kind=$1 where=$(printf '%s' "${2:-}" | clean)
	clean_lines | while read -r name version; do
		[ -n "$name" ] || continue
		printf ',{"kind":"%s","name":"%s","version":"%s"' "$kind" "$name" "$version"
		[ -n "$where" ] && printf ',"where":"%s"' "$where"
		printf '}'
	done
}

# Every folder called $2 inside app $1, its own first, then any a bundled tool carries deeper down (a file browser with
# its own Composer packages, say), as "folder<tab>where" lines. Folders that hold no code are skipped, and so is
# everything inside an installed set; links are not followed.
inside() {
	find "$1" -maxdepth 10 -type d \( -name .git -o -name .svn -o -name cache -o -name tmp -o -name logs -o -name uploads -o -name images -o -name storage \) -prune \
		-o -type d -name "$2" -print -prune 2>/dev/null | while read -r found; do
		where=${found%/"$2"}; where=${where#"$1"}; printf '%s\t%s\n' "$found" "${where#/}"
	done
}

one() { [ -n "$3" ] && printf ',{"kind":"%s","name":"%s","version":"%s"}' "$1" "$2" "$(printf '%s' "$3" | clean)"; return 0; }
first_version() { grep -o '[0-9][0-9]*\.[0-9][0-9.]*' | head -n 1; }
has() { command -v "$1" >/dev/null 2>&1; }

list() {
	os_id=''; os_version=''
	if [ -r /etc/os-release ]; then
		os_id=$(. /etc/os-release && printf '%s' "${ID:-}" | clean)
		os_version=$(. /etc/os-release && printf '%s' "${VERSION_ID:-}" | clean)
	fi
	printf '{"helper":{"kind":"linux","version":"%s"},"software":[' "$VERSION"
	printf '{"kind":"os","name":"%s","version":"%s"}' "${os_id:-linux}" "$os_version"

	# The system's packages. On Debian and Ubuntu the source package is what security notices name.
	if has dpkg-query; then
		dpkg-query -W -f='${db:Status-Status} ${source:Package} ${source:Version}\n' 2>/dev/null | awk '$1 == "installed" { print $2, $3 }' | sort -u | entries deb
	elif has rpm; then
		rpm -qa --qf '%{NAME} %{EPOCH}:%{VERSION}-%{RELEASE}\n' 2>/dev/null | sed 's/ (none):/ /' | sort -u | entries rpm
	elif has apk; then
		# "openssl-3.3.2-r0 x86_64 {openssl} ..." gives the origin package and its version.
		apk list --installed 2>/dev/null | awk '{ n = split($1, p, "-"); v = p[n-1] "-" p[n]; o = $3; gsub(/[{}]/, "", o); print o, v }' | sort -u | entries apk
	fi

	has nginx && one server nginx "$(nginx -v 2>&1 | first_version)"
	if has apache2; then one server apache "$(apache2 -v 2>/dev/null | first_version)"; elif has httpd; then one server apache "$(httpd -v 2>/dev/null | first_version)"; fi
	has php && one php php "$(php -r 'echo PHP_VERSION;' 2>/dev/null)"
	has node && one node node "$(node -v 2>/dev/null | first_version)"
	if has mariadb; then
		one db mariadb "$(mariadb --version 2>/dev/null | sed 's/.*Distrib //' | first_version)"
	elif has mysql; then
		v=$(mysql --version 2>/dev/null)
		case "$v" in *MariaDB*) one db mariadb "$(printf '%s' "$v" | sed 's/.*Distrib //' | first_version)" ;; *) one db mysql "$(printf '%s' "$v" | sed 's/.*Ver //' | first_version)" ;; esac
	fi
	has psql && one db postgresql "$(psql --version 2>/dev/null | first_version)"
	for app in $APPS; do app "$app"; done
	printf '],"settings":{}}\n'
}

# The apps: only files are read, so nothing in them runs. Each part prints "name version" lines for entries().
python_names() { awk '{ n = tolower($1); gsub(/[-_.]+/, "-", n); print n, $2 }'; }
app_python() {
	found=''
	for site in "$1"/venv/lib/python*/site-packages "$1"/.venv/lib/python*/site-packages "$1"/env/lib/python*/site-packages; do
		[ -d "$site" ] || continue
		found=yes
		# Each installed package has a folder called name-version.dist-info.
		ls "$site" | sed -n 's/^\([^-]*\)-\([^-]*\)\.dist-info$/\1 \2/p' | python_names | entries pypi
	done
	if [ -z "$found" ]; then
		for req in "$1"/requirements*.txt; do
			[ -r "$req" ] && sed -n 's/^\([A-Za-z0-9][A-Za-z0-9._-]*\)\(\[[^]]*\]\)\{0,1\}[[:space:]]*==[[:space:]]*\([A-Za-z0-9.!+-]*\).*/\1 \3/p' "$req" | python_names | entries pypi
		done
	fi
	return 0
}
app_node() {
	inside "$1" node_modules | while IFS='	' read -r modules where; do
		for pkg in "$modules"/*/package.json "$modules"/@*/*/package.json; do
			[ -f "$pkg" ] || continue
			dir=${pkg%/package.json}
			# The first "version" in the file, which is the package's own, whether the file is spread out or on one line.
			printf '%s %s\n' "${dir#"$modules"/}" "$(grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$pkg" | head -n 1 | sed 's/.*"\([^"]*\)"$/\1/')"
		done | entries npm "$where"
	done
}
app_php() {
	has php || return 0
	inside "$1" vendor | while IFS='	' read -r vendor where; do
		[ -r "$vendor/composer/installed.json" ] || continue
		# Composer's own record of what it installed, leaving out packages for development only.
		php -r '$d = json_decode(file_get_contents($argv[1]), true); $dev = isset($d["dev-package-names"]) ? $d["dev-package-names"] : array();
			foreach (isset($d["packages"]) ? $d["packages"] : (array) $d as $p) { if (isset($p["name"], $p["version"]) && !in_array($p["name"], $dev, true)) { echo $p["name"], " ", ltrim($p["version"], "v"), "\n"; } }' "$vendor/composer/installed.json" | entries composer "$where"
	done
	return 0
}
# Script libraries copied into an app by hand, which no package record lists: each file's opening comment, where
# libraries put their name and version, and the first version its code sets. Mendbird works out which library it is.
# Only files that give a version are sent, at most 1,000.
app_scripts() {
	find "$1" -maxdepth 10 -type d \( -name .git -o -name node_modules -o -name vendor -o -name cache -o -name tmp -o -name logs -o -name uploads -o -name images -o -name storage \) -prune \
		-o -type f -name '*.js' -size -3000k -print 2>/dev/null | head -n 1000 | while read -r file; do
		about=$(head -c 1024 "$file" | awk '
			NR == 1 { sub(/^[ \t]+/, "") }
			!started && /^[ \t]*$/ { next }
			!started { if ($0 ~ /^[ \t]*\/\*/) style = "block"; else if ($0 ~ /^[ \t]*\/\//) style = "line"; else exit; started = 1 }
			style == "line" && $0 !~ /^[ \t]*\/\// { exit }
			{ done = style == "block" && /\*\// ; line = $0; gsub(/^[ \t]*(\/\*+!?|\*+\/?|\/\/+!?)[ \t]*|[ \t]*\*+\/.*$/, "", line); if (line != "") out = out (out == "" ? "" : " | ") line; if (done) exit }
			END { print out }' | tr -c "A-Za-z0-9_ .+:~@/|(),!#=<>&;'\n-" ' ' | sed 's/  */ /g; s/^ //; s/ $//' | cut -c1-160)
		version=$(grep -o -m 1 -E "(VERSION|version)[[:space:]]*[:=][[:space:]]*[\"']v?[0-9]+\.[0-9]+\.[0-9]+[\"']" "$file" 2>/dev/null | head -n 1 | grep -o -E '[0-9]+\.[0-9]+\.[0-9]+' || true)
		[ -n "$version" ] || printf '%s' "$about" | grep -q -E '[0-9]+\.[0-9]+' || continue
		where=${file%/*}; where=${where#"$1"}; where=$(printf '%s' "${where#/}" | clean)
		printf ',{"kind":"script","name":"%s","version":"%s","about":"%s"' "$(printf '%s' "${file##*/}" | clean)" "$version" "$about"
		[ -n "$where" ] && printf ',"where":"%s"' "$where"
		printf '}'
	done
}
app_go_program() {
	# A Go program carries the list of modules it was built from, and its Go version, as plain text between zero bytes.
	# Only that text is read; the program is never run.
	text=$(tr '\000' '\n' < "$1" | awk -F '\t' '$1 == "mod" || $1 == "dep" { print $1, $2, $3 } /^go1\.[0-9]+\.[0-9]+$/ { print "go", $0 }' | sort -u)
	printf '%s\n' "$text" | grep -q '^mod ' || return 0
	one go stdlib "$(printf '%s\n' "$text" | sed -n 's/^go go//p' | head -n 1)"
	printf '%s\n' "$text" | awk '$1 == "dep" { print $2, $3 }' | entries go
}
app() {
	if [ -f "$1" ]; then app_go_program "$1"; return 0; fi
	[ -d "$1" ] || { echo "mendbird-helper: $1 is not a folder or a file, so it was left out" >&2; return 0; }
	app_python "$1"
	app_node "$1"
	app_php "$1"
	app_scripts "$1"
	[ -r "$1/Gemfile.lock" ] && sed -n 's/^    \([A-Za-z0-9._-]*\) (\([^)[:space:]-]*\).*/\1 \2/p' "$1/Gemfile.lock" | entries gem
	[ -r "$1/Cargo.lock" ] && awk '/^\[\[package\]\]/ { n = "" } /^name = / { gsub(/"/, "", $3); n = $3 } /^version = / { gsub(/"/, "", $3); if (n != "") print n, $3; n = "" }' "$1/Cargo.lock" | entries cargo
	[ -r "$1/go.mod" ] && awk '$1 == "require" && $3 ~ /^v/ { print $2, $3 } /^\t/ && $2 ~ /^v/ && $1 ~ /\./ { print $1, $2 }' "$1/go.mod" | entries go
	for program in "$1"/* "$1"/bin/*; do
		[ -f "$program" ] && [ -x "$program" ] && app_go_program "$program"
	done
	return 0
}

case "${1:-}" in
	--show) list; exit 0 ;;
	--version) echo "mendbird-helper $VERSION"; exit 0 ;;
	"") ;;
	*) echo "Usage: mendbird-helper [--show]" >&2; exit 2 ;;
esac

for tool in curl openssl; do
	has "$tool" || { echo "mendbird-helper needs $tool" >&2; exit 1; }
done

# The key is in this file, so other users on the server should not be able to read it.
case $(ls -ld "$0" | cut -c5-10) in
	*r*) echo "mendbird-helper: other users on this server can read this file and the key in it. Run: chmod 700 $0" >&2 ;;
esac

# HMAC-SHA256, worked out here rather than with openssl's -hmac option, so the key is never on a command line where
# other users could see it in the list of running programs. $1 is 54 for the inner pad and 92 for the outer one.
pad() {
	k=$KEY i=0
	while [ "$i" -lt 64 ]; do
		c=0
		if [ -n "$k" ]; then c=$(printf '%d' "'${k%"${k#?}"}"); k=${k#?}; fi
		printf '%b' "\\0$(printf '%o' $((c ^ $1)))"
		i=$((i + 1))
	done
}

body=$(mktemp) inner=$(mktemp)
trap 'rm -f "$body" "$inner"' EXIT
list > "$body"
time=$(date +%s)
{ pad 54; printf 'push:%s:' "$time"; cat "$body"; } | openssl dgst -sha256 -binary > "$inner"
sign=$( { pad 92; cat "$inner"; } | openssl dgst -sha256 | sed 's/^.*= *//')
curl -fsS --max-time 30 -X POST "$URL" \
	-H 'content-type: application/json' \
	-H "mendbird-site: $SITE" \
	-H "mendbird-time: $time" \
	-H "mendbird-sign: $sign" \
	--data-binary "@$body" >/dev/null
